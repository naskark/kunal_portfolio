# Contact form delivery (Web3Forms).
# Get a free access key at https://web3forms.com by entering your email —
# the key arrives in your inbox. Copy this file to .env.local and paste it here.
#
# Note: Web3Forms' free plan only accepts submissions from the browser
# (server-side requests are rejected as "Pro plan is required"), so this key is
# necessarily public. That is how Web3Forms is designed — the key only allows
# sending mail to your own inbox. Rotate it in their dashboard if it gets abused.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional: point the portfolio content at a backend API instead of the
# bundled static data in src/data/portfolio.ts.
# NEXT_PUBLIC_PORTFOLIO_API_URL=
